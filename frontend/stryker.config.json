{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "reporters": ["html", "clear-text", "progress"],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.d.ts",
    "!src/device/keymap.ts",
    "!src/device/charaChorderProtocol.ts",
    "!src/device/charaChorderDevice.ts",
    "!src/device/mockSerialTransport.ts",
    "!src/device/webSerialTransport.ts",
    "!src/device.ts",
    "!src/cc.ts",
    "!src/main.ts"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  }
}
